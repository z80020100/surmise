{
  "description": "Manage your dotfiles across multiple diverse machines, securely",
  "name": "chezmoi",
  "options": [
    {
      "args": [
        {
          "default": "~/.cache/chezmoi",
          "name": "cache"
        }
      ],
      "description": "Set cache directory",
      "isPersistent": true,
      "name": "--cache",
      "requiresSeparator": true
    },
    {
      "args": [
        {
          "default": "auto",
          "name": "color",
          "suggestions": [
            "true",
            "false",
            "auto"
          ]
        }
      ],
      "description": "Colorize output",
      "isPersistent": true,
      "name": "--color",
      "requiresSeparator": true
    },
    {
      "args": [
        {
          "default": "~/.config/chezmoi/chezmoi.toml",
          "name": "config",
          "template": [
            "filepaths"
          ]
        }
      ],
      "description": "Set config file",
      "isPersistent": true,
      "name": [
        "--config",
        "-c"
      ],
      "requiresSeparator": true
    },
    {
      "args": [
        {
          "name": "config-format",
          "suggestions": [
            "json",
            "toml",
            "yaml"
          ]
        }
      ],
      "description": "Set config file format",
      "isPersistent": true,
      "name": "--config-format",
      "requiresSeparator": true
    },
    {
      "args": [
        {
          "name": "cpu-profile",
          "template": [
            "filepaths"
          ]
        }
      ],
      "description": "Write a CPU profile to path",
      "hidden": true,
      "isPersistent": true,
      "name": "--cpu-profile",
      "requiresSeparator": true
    },
    {
      "description": "Include debug information in output",
      "isPersistent": true,
      "name": "--debug"
    },
    {
      "args": [
        {
          "default": "~",
          "name": "destination",
          "template": [
            "folders"
          ]
        }
      ],
      "description": "Set destination directory",
      "isPersistent": true,
      "name": [
        "--destination",
        "-D"
      ],
      "requiresSeparator": true
    },
    {
      "description": "Do not make any modifications to the destination directory",
      "isPersistent": true,
      "name": [
        "--dry-run",
        "-n"
      ]
    },
    {
      "description": "Make all changes without prompting",
      "isPersistent": true,
      "name": "--force"
    },
    {
      "description": "Enable gops agent",
      "hidden": true,
      "isPersistent": true,
      "name": "--gops"
    },
    {
      "description": "Prompt for all changes",
      "isPersistent": true,
      "name": "--interactive"
    },
    {
      "description": "Keep going as far as possible after an error",
      "isPersistent": true,
      "name": [
        "--keep-going",
        "-k"
      ]
    },
    {
      "args": [
        {
          "name": "mode",
          "suggestions": [
            "file",
            "symlink"
          ]
        }
      ],
      "description": "Mode",
      "isPersistent": true,
      "name": "--mode",
      "requiresSeparator": true
    },
    {
      "description": "Do not use the pager",
      "isPersistent": true,
      "name": "--no-pager"
    },
    {
      "description": "Do not attempt to get a TTY for reading passwords",
      "isPersistent": true,
      "name": "--no-tty"
    },
    {
