{
  "description": "Manage deployment scripts at subscription or resource group scope",
  "name": "deployment-scripts",
  "subcommands": [
    {
      "description": "Delete a deployment script",
      "name": "delete",
      "options": [
        {
          "args": [
            {
              "name": "name"
            }
          ],
          "description": "Deployment script resource name",
          "isRequired": true,
          "name": "--name"
        },
        {
          "args": [
            {
              "name": "resource-group"
            }
          ],
          "description": "Name of resource group. You can configure the default group using az configure --defaults group=<name>",
          "isRequired": true,
          "name": [
            "--resource-group",
            "-g"
          ]
        },
        {
          "description": "Do not prompt for confirmation",
          "name": [
            "--yes",
            "-y"
          ]
        }
      ]
    },
    {
      "description": "List all deployment scripts",
      "name": "list",
      "options": [
        {
          "args": [
            {
              "name": "resource-group"
            }
          ],
          "description": "Name of resource group. You can configure the default group using az configure --defaults group=<name>",
          "name": [
            "--resource-group",
            "-g"
          ]
        }
      ]
    },
    {
      "description": "Retrieve a deployment script",
      "name": "show",
      "options": [
        {
          "args": [
            {
              "name": "name"
            }
          ],
          "description": "Deployment script resource name",
          "isRequired": true,
          "name": "--name"
        },
        {
          "args": [
            {
              "name": "resource-group"
            }
          ],
          "description": "Name of resource group. You can configure the default group using az configure --defaults group=<name>",
          "isRequired": true,
          "name": [
            "--resource-group",
            "-g"
          ]
        }
      ]
    },
    {
      "description": "Show deployment script logs",
      "name": "show-log",
      "options": [
        {
          "args": [
            {
              "name": "name"
            }
          ],
          "description": "Deployment script resource name",
          "isRequired": true,
          "name": "--name"
        },
        {
          "args": [
            {
              "name": "resource-group"
            }
          ],
          "description": "Name of resource group. You can configure the default group using az configure --defaults group=<name>",
          "isRequired": true,
          "name": [
            "--resource-group",
            "-g"
          ]
        }
      ]
    }
  ]
}
