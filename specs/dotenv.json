{
  "args": [
    {
      "isCommand": true
    }
  ],
  "description": "Loads environment variables from .env",
  "name": "dotenv",
  "options": [
    {
      "args": [
        {
          "template": "filepaths"
        }
      ],
      "description": "List of env files to parse",
      "exclusiveOn": [
        "-h",
        "-v",
        "-t"
      ],
      "name": "-f"
    },
    {
      "description": "Display help",
      "exclusiveOn": [
        "-f",
        "-v",
        "-t"
      ],
      "name": [
        "-h",
        "--help"
      ]
    },
    {
      "description": "Show version",
      "exclusiveOn": [
        "-f",
        "-h",
        "-t"
      ],
      "name": [
        "-v",
        "--version"
      ]
    },
    {
      "args": [
        {
          "template": "filepaths"
        }
      ],
      "description": "Create a template env file",
      "exclusiveOn": [
        "-f",
        "-h",
        "-v"
      ],
      "name": [
        "-t",
        "--template"
      ]
    }
  ]
}
