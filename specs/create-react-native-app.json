{
  "args": [
    {
      "name": "name",
      "template": "folders"
    }
  ],
  "description": "Creates a new React Native project",
  "name": "create-react-native-app",
  "options": [
    {
      "args": [
        {
          "name": "template"
        }
      ],
      "description": "The name of a template from expo/examples or URL to a GitHub repo that contains an example",
      "icon": "https://raw.githubusercontent.com/expo/expo-cli/master/assets/fig/export.png",
      "name": "--template",
      "priority": 76
    },
    {
      "args": [
        {
          "name": "name"
        }
      ],
      "description": "The path inside of a GitHub repo where the example lives",
      "icon": "https://raw.githubusercontent.com/expo/expo-cli/master/assets/fig/path.png",
      "name": "--template-path",
      "priority": 76
    },
    {
      "args": [
        {
          "isOptional": true,
          "name": "boolean",
          "suggestions": [
            {
              "icon": "https://raw.githubusercontent.com/expo/expo-cli/master/assets/fig/true.png",
              "name": "true"
            },
            {
              "icon": "https://raw.githubusercontent.com/expo/expo-cli/master/assets/fig/false.png",
              "name": "false"
            }
          ]
        }
      ],
      "description": "Use the default options for creating a project",
      "icon": "https://raw.githubusercontent.com/expo/expo-cli/master/assets/fig/skip.png",
      "name": "--yes",
      "priority": 76
    },
    {
      "args": [
        {
          "isOptional": true,
          "name": "boolean",
          "suggestions": [
            {
              "icon": "https://raw.githubusercontent.com/expo/expo-cli/master/assets/fig/true.png",
              "name": "true"
            },
            {
              "icon": "https://raw.githubusercontent.com/expo/expo-cli/master/assets/fig/false.png",
              "name": "false"
            }
          ]
        }
      ],
      "description": "Skip installing npm packages or CocoaPods",
      "icon": "https://raw.githubusercontent.com/expo/expo-cli/master/assets/fig/skip.png",
      "name": "--no-install",
      "priority": 76
    },
    {
      "args": [
        {
          "isOptional": true,
          "name": "boolean",
          "suggestions": [
            {
              "icon": "https://raw.githubusercontent.com/expo/expo-cli/master/assets/fig/true.png",
              "name": "true"
            },
            {
              "icon": "https://raw.githubusercontent.com/expo/expo-cli/master/assets/fig/false.png",
              "name": "false"
            }
          ]
        }
      ],
      "description": "Use npm to install dependencies. (default when Yarn is not installed)",
      "icon": "fig://icon?type=npm",
      "name": "--use-npm",
      "priority": 76
