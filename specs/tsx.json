{
  "args": [
    {
      "dyn": true,
      "generators": [
        {}
      ],
      "isScript": true,
      "name": "script path"
    }
  ],
  "description": "Run TypeScript file using tsx",
  "name": "tsx",
  "options": [
    {
      "description": "Show help for tsx",
      "isPersistent": true,
      "name": [
        "--help",
        "-h"
      ]
    },
    {
      "description": "Disable caching",
      "isPersistent": true,
      "name": "--no-cache"
    },
    {
      "args": [
        {
          "dyn": true,
          "generators": [
            {}
          ],
          "isScript": true,
          "name": "script path"
        }
      ],
      "dependsOn": [
        "watch"
      ],
      "description": "Disable clearing the screen on rerun",
      "insertValue": "--clear-screen=false",
      "isPersistent": true,
      "name": "--clear-screen"
    },
    {
      "description": "Show version",
      "name": [
        "-v",
        "--version"
      ]
    },
    {
      "args": [
        {
          "dyn": true,
          "generators": [
            {}
          ],
          "name": "tsconfig.json path"
        }
      ],
      "description": "Custom tsconfig.json path",
      "name": "--tsconfig"
    }
  ],
  "subcommands": [
    {
      "args": [
        {
          "dyn": true,
          "generators": [
            {}
          ],
          "isScript": true,
          "name": "script path"
        }
      ],
      "description": "Run the script and watch for changes",
      "name": "watch"
    }
  ]
}
