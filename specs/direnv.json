    {
      "args": [
        {
          "isOptional": true,
          "name": "VERSION_AT_LEAST"
        }
      ],
      "description": "Prints the version or checks that direnv is older than VERSION_AT_LEAST",
      "name": "--version"
    },
    {
      "args": [
        {
          "description": "Any string",
          "isOptional": true,
          "name": "SHOW_PRIVATE"
        }
      ],
      "description": "Help for direnv",
      "name": "--help"
    }
  ],
  "subcommands": [
    {
      "args": [
        {
          "generators": [
            {
              "template": "filepaths"
            }
          ],
          "isOptional": true,
          "name": "PATH_TO_RC"
        }
      ],
      "description": "Grants direnv to load the given .envrc",
      "isDangerous": true,
      "name": "allow"
    },
    {
      "args": [
        {
          "generators": [
            {
              "template": "filepaths"
            }
          ],
          "isOptional": true,
          "name": "PATH_TO_RC"
        }
      ],
      "description": "Revokes the authorization of a given .envrc",
      "isDangerous": true,
      "name": "deny"
