{
  "description": "Publish a spec to fig teams",
  "name": "@fig/publish-spec",
  "options": [
    {
      "description": "Output the version number",
      "name": [
        "-V",
        "--version"
      ]
    },
    {
      "description": "Publish a spec interactively",
      "name": [
        "-i",
        "--interactive"
      ]
    },
    {
      "args": [
        {
          "name": "string"
        }
      ],
      "description": "A fig token",
      "name": [
        "-t",
        "--token"
      ]
    },
    {
      "args": [
        {
          "name": "string"
        }
      ],
      "description": "Set the namespace of the published spec",
      "name": "--team"
    },
    {
      "args": [
        {
          "name": "string"
        }
      ],
      "description": "Set the name of the published spec",
      "name": [
        "-n",
        "--name"
      ]
    },
    {
      "args": [
        {
          "name": "path",
          "template": [
            "filepaths"
          ]
        }
      ],
      "description": "The local path of the spec to publish",
      "name": [
        "-p",
        "--spec-path"
      ]
    },
    {
      "args": [
        {
          "name": "path",
          "template": [
            "filepaths"
          ]
        }
      ],
      "description": "The path of the binary to run to generate the spec",
      "name": [
        "-b",
        "--binary-path"
      ]
    },
    {
      "args": [
        {
          "name": "string"
        }
      ],
      "description": "The subcommand of the binary used to generate the spec",
      "name": [
        "-s",
        "--subcommand-name"
      ]
    },
    {
      "description": "The spec is a local script and will only be loaded when referenced in a fig/config.json file",
      "name": "--is-script"
    },
    {
      "args": [
        {
          "name": "string"
        }
      ],
      "description": "Framework used to build the CLI",
      "name": [
        "-f",
        "--framework"
      ]
    },
    {
      "description": "Display help for command",
      "name": [
        "-h",
        "--help"
      ],
      "priority": 49
    }
  ],
  "subcommands": [
    {
      "args": [
        {
          "isOptional": true,
          "name": "command"
        }
      ],
      "description": "Display help for command",
      "name": "help",
      "priority": 49
    }
  ]
}
