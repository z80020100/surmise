{
  "description": "Manage packages and bundle versions in Capgo Cloud",
  "name": "cli",
  "subcommands": [
    {
      "args": [
        {
          "name": "apikey"
        }
      ],
      "description": "Save apikey to your machine or folder",
      "name": "login",
      "options": [
        {
          "description": "Only save in local folder",
          "name": "--local"
        }
      ]
    },
    {
      "description": "Get info about your Capgo app install",
      "name": "doctor"
    },
    {
      "args": [
        {
          "name": "apikey"
        },
        {
          "name": "appId"
        }
      ],
      "description": "Init a new app",
      "name": "init",
      "options": [
        {
          "args": [
            {
              "name": "name"
            }
          ],
          "description": "App name",
          "name": [
            "-n",
            "--name"
          ]
        },
        {
          "args": [
            {
              "name": "icon",
              "template": "filepaths"
            }
          ],
          "description": "App icon path",
          "name": [
            "-i",
            "--icon"
          ]
        },
        {
          "args": [
            {
              "name": "apikey"
            }
          ],
          "description": "Apikey to link to your account",
          "name": [
            "-a",
            "--apikey"
          ]
        }
      ]
    },
    {
      "description": "Manage app",
      "name": "app",
      "subcommands": [
        {
          "args": [
            {
              "name": "appId"
            }
          ],
          "description": "Add a new app in Capgo Cloud",
          "name": [
            "add",
            "a"
          ],
          "options": [
            {
              "args": [
                {
                  "name": "name"
                }
              ],
              "description": "App name",
              "name": [
                "-n",
                "--name"
              ]
            },
            {
              "args": [
                {
                  "name": "icon",
                  "template": "filepaths"
                }
              ],
              "description": "App icon path",
              "name": [
                "-i",
                "--icon"
              ]
            },
            {
              "args": [
                {
                  "name": "apikey"
                }
              ],
              "description": "Apikey to link to your account",
              "name": [
                "-a",
                "--apikey"
              ]
            }
          ]
        },
        {
          "args": [
            {
              "name": "appId"
            }
          ],
          "description": "Delete an app in Capgo Cloud",
          "name": [
            "delete",
            "d"
          ],
          "options": [
            {
              "args": [
                {
                  "name": "apikey"
                }
              ],
              "description": "Apikey to link to your account",
              "name": [
                "-a",
                "--apikey"
              ]
            }
          ]
        },
        {
          "description": "List apps in Capgo Cloud",
          "name": [
            "list",
            "l"
          ],
          "options": [
            {
              "args": [
                {
                  "name": "apikey"
                }
              ],
              "description": "Apikey to link to your account",
              "name": [
                "-a",
                "--apikey"
              ]
            }
          ]
        },
        {
          "args": [
            {
              "name": "appId"
            }
          ],
          "description": "Listen for live updates event in Capgo Cloud to debug your app",
          "name": "debug",
          "options": [
            {
              "args": [
                {
                  "name": "apikey"
                }
              ],
              "description": "Apikey to link to your account",
              "name": [
                "-a",
                "--apikey"
              ]
            },
            {
              "args": [
                {
                  "name": "device"
                }
              ],
              "description": "The specific device to debug",
              "name": [
                "-d",
                "--device"
              ]
            }
          ]
        },
        {
          "args": [
            {
              "name": "appId"
            }
          ],
          "description": "Set an app in Capgo Cloud",
          "name": [
            "set",
            "s"
          ],
          "options": [
            {
              "args": [
                {
                  "name": "name"
                }
              ],
              "description": "App name",
              "name": [
                "-n",
                "--name"
              ]
            },
            {
              "args": [
                {
                  "name": "icon",
                  "template": "filepaths"
                }
              ],
              "description": "App icon path",
              "name": [
                "-i",
                "--icon"
              ]
            },
            {
              "args": [
                {
                  "name": "apikey"
                }
              ],
              "description": "Apikey to link to your account",
              "name": [
                "-a",
                "--apikey"
              ]
            },
            {
              "args": [
                {
                  "name": "retention"
                }
              ],
              "description": "Retention period of app bundle in days",
              "name": [
                "-r",
                "--retention"
              ]
            }
          ]
        }
      ]
    },
    {
      "description": "Manage bundle",
      "name": "bundle",
      "subcommands": [
        {
          "args": [
            {
              "name": "bundleId"
            },
            {
              "name": "appId"
            }
          ],
          "description": "Delete a bundle in Capgo Cloud",
          "name": [
            "delete",
            "d"
          ],
          "options": [
            {
              "args": [
                {
                  "name": "apikey"
                }
              ],
              "description": "Apikey to link to your account",
              "name": [
                "-a",
                "--apikey"
              ]
            }
          ]
        },
        {
          "args": [
            {
              "name": "zipPath",
              "template": "filepaths"
            },
            {
              "name": "sessionKey"
            }
          ],
          "description": "Decrypt a signed zip bundle",
          "name": [
            "decrypt",
            "l"
          ],
          "options": [
            {
              "args": [
                {
                  "name": "key",
                  "template": "filepaths"
                }
              ],
              "description": "Custom path for private signing key",
              "name": "--key"
            },
            {
              "args": [
                {
                  "name": "keyData"
                }
              ],
              "description": "Base64 private signing key",
              "name": "--key-data"
            }
          ]
        },
        {
          "args": [
            {
              "name": "zipPath",
              "template": "filepaths"
            }
          ],
          "description": "Encrypt a zip bundle",
          "name": "encrypt",
          "options": [
            {
              "args": [
                {
                  "name": "key",
                  "template": "filepaths"
                }
              ],
              "description": "Custom path for private signing key",
              "name": "--key"
            },
            {
              "args": [
                {
                  "name": "keyData"
                }
              ],
              "description": "Base64 private signing key",
              "name": "--key-data"
            }
          ]
        },
        {
          "args": [
            {
              "name": "appId"
            }
          ],
          "description": "Zip a bundle",
          "name": "zip",
          "options": [
            {
              "args": [
                {
                  "name": "path",
                  "template": "folders"
                }
              ],
              "description": "Path of the folder to upload",
              "name": [
                "-p",
                "--path"
              ]
            }
          ]
        }
      ]
    },
    {
      "description": "Manage channel",
      "name": "channel",
      "subcommands": [
        {
          "args": [
            {
              "name": "channelId"
            },
            {
              "name": "appId"
            }
          ],
          "description": "Create channel",
          "name": [
            "add",
            "a"
          ],
          "options": [
            {
              "description": "Set the channel as default",
              "name": [
                "-d",
                "--default"
              ]
            }
          ]
        },
        {
          "args": [
            {
              "name": "channelId"
            },
            {
              "name": "appId"
            }
          ],
          "description": "Delete channel",
          "name": [
            "delete",
            "d"
          ]
        },
        {
          "args": [
            {
              "name": "appId"
            }
          ],
          "description": "List channel",
          "name": [
            "list",
            "l"
          ]
        },
        {
          "args": [
            {
              "name": "channel"
            },
            {
              "name": "appId"
            }
          ],
          "description": "Get current bundle for specific channel in Capgo Cloud",
          "name": "currentBundle",
          "options": [
            {
              "args": [
                {
                  "name": "channel"
                }
              ],
              "description": "Channel to get the current bundle from",
              "name": [
                "-c",
                "--channel"
              ]
            },
            {
              "args": [
                {
                  "name": "apikey"
                }
              ],
              "description": "Apikey to link to your account",
              "name": [
                "-a",
                "--apikey"
              ]
            },
            {
              "description": "Only print the bundle version",
              "name": "--quiet"
            }
          ]
        },
        {
          "args": [
            {
              "name": "channelId"
            },
            {
              "name": "appId"
            }
          ],
          "description": "Set channel",
          "name": [
            "set",
            "s"
          ]
        }
      ]
    },
    {
      "description": "Manage key",
      "name": "key",
      "subcommands": [
        {
          "description": "Save base64 signing key in capacitor config, useful for CI",
          "name": "save",
          "options": [
            {
              "description": "Force generate a new one",
              "name": [
                "-f",
                "--force"
              ]
            },
            {
              "args": [
                {
                  "name": "key",
                  "template": "filepaths"
                }
              ],
              "description": "Key path to save in capacitor config",
              "name": "--key"
            },
            {
              "args": [
                {
                  "name": "keyData"
                }
              ],
              "description": "Key data to save in capacitor config",
              "name": "--key-data"
            }
          ]
        },
        {
          "description": "Create a new signing key",
          "name": "create",
          "options": [
            {
              "description": "Force generate a new one",
              "name": [
                "-f",
                "--force"
              ]
            }
          ]
        }
      ]
    }
  ]
}
