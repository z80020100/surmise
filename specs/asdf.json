{
  "description": "Extendable version manager with support for Ruby, Node.js, Elixir, Erlang & more",
  "name": "asdf",
  "options": [
    {
      "description": "Version for asdf",
      "name": "--version"
    },
    {
      "description": "Help for asdf",
      "name": [
        "-h",
        "--help"
      ]
    }
  ],
  "subcommands": [
    {
      "description": "Plugin management sub-commands",
      "name": "plugin",
      "subcommands": [
        {
          "args": [
            {
              "dyn": true,
              "generators": [
                {}
              ],
              "name": "name"
            },
            {
              "isOptional": true,
              "name": "git-url"
            }
          ],
          "description": "Add a plugin from the plugin repo OR, add a Git repo as a plugin by specifying the name and repo url",
          "name": "add"
        },
        {
          "description": "List installed plugins. Optionally show git urls and git-ref",
          "name": "list",
          "options": [
            {
              "description": "Show git urls",
              "name": "--urls"
            },
            {
              "description": "Show git refs",
              "name": "--refs"
            }
          ],
          "subcommands": [
            {
              "description": "List plugins registered on asdf-plugins repository with URLs",
              "name": "all"
            }
          ]
        },
        {
          "args": [
            {
              "dyn": true,
              "generators": [
                {
                  "script": [
                    "asdf",
                    "plugin-list"
                  ]
                }
              ],
              "name": "name"
            }
          ],
          "description": "Remove plugin and package versions",
          "name": "remove"
        },
        {
          "args": [
            {
              "isDangerous": true,
              "isOptional": true,
              "name": "name"
            },
            {
              "isDangerous": true,
              "isOptional": true,
              "name": "git-ref"
            }
          ],
          "description": "Update a plugin to latest commit on default branch or a particular git-ref",
          "name": "update",
          "options": [
            {
              "description": "Update all plugins to latest commit on default branch",
              "isDangerous": true,
              "name": "--all"
            }
          ]
        }
      ]
    },
    {
      "args": [
        {
          "dyn": true,
          "generators": [
            {}
          ],
          "name": "name"
        },
        {
          "isOptional": true,
          "name": "git-url"
        }
      ],
      "description": "Add a plugin from the plugin repo OR, add a Git repo as a plugin by specifying the name and repo url",
      "name": "plugin-add"
    },
    {
      "description": "List installed plugins. Optionally show git urls and git-ref",
      "name": "plugin-list",
      "options": [
        {
          "description": "Show git urls",
          "name": "--urls"
        },
        {
          "description": "Show git refs",
          "name": "--refs"
        }
      ],
      "subcommands": [
        {
          "description": "List plugins registered on asdf-plugins repository with URLs",
          "name": "all"
        }
      ]
    },
    {
      "description": "List plugins registered on asdf-plugins repository with URLs",
      "name": "plugin-list-all"
    },
    {
      "args": [
        {
          "dyn": true,
          "generators": [
            {
              "script": [
                "asdf",
                "plugin-list"
              ]
            }
          ],
          "name": "name"
        }
      ],
      "description": "Remove plugin and package versions",
      "name": "plugin-remove"
    },
    {
      "args": [
        {
          "isDangerous": true,
          "isOptional": true,
          "name": "name"
        },
        {
          "isDangerous": true,
          "isOptional": true,
          "name": "git-ref"
        }
      ],
      "description": "Update a plugin to latest commit on default branch or a particular git-ref",
      "name": "plugin-update",
      "options": [
        {
          "description": "Update all plugins to latest commit on default branch",
          "isDangerous": true,
