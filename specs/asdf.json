        }
      ]
    },
    {
      "args": [
        {
          "dyn": true,
          "generators": [
            {
              "script": [
                "asdf",
                "plugin-list"
              ]
            }
          ],
          "isOptional": true,
          "name": "name"
        },
        {
          "dyn": true,
          "generators": [
            {
              "cache": {
                "ttl": 3600000
              }
            }
          ],
          "isOptional": true,
          "name": "version",
          "suggestions": [
            {
              "isDangerous": true,
              "name": "latest"
            }
          ]
        }
      ],
