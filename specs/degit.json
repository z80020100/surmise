{
  "args": [
    {
      "dyn": true,
      "generators": [
        {}
      ],
      "name": "user/repo"
    },
    {
      "isOptional": true,
      "name": "location",
      "suggestCurrentToken": true,
      "template": "folders"
    }
  ],
  "description": "Straightforward project scaffolding",
  "name": "degit",
  "options": [
    {
      "description": "Print help",
      "name": "--help"
    },
    {
      "description": "Overwrite existing files",
      "name": [
        "-f",
        "--force"
      ]
    },
    {
      "description": "Use a cache",
      "name": [
        "-c",
        "--cache"
      ]
    },
    {
      "description": "Be verbose?",
      "name": [
        "-v",
        "--verbose"
      ]
    },
    {
      "args": [
        {
          "name": "mode",
          "suggestions": [
            "git",
            "tar"
          ]
        }
      ],
      "description": "Clone mode",
      "name": [
        "-m",
        "--mode"
      ]
    }
  ]
}
