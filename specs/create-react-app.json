{
  "args": [
    {
      "name": "name",
      "template": "folders"
    }
  ],
  "description": "Creates a new React project",
  "name": "create-react-app",
  "options": [
    {
      "args": [
        {
          "name": "name or url"
        }
      ],
      "description": "Specify a template for the created project (a custom template on npm (search for \"cra-template-*\"), a relative path, or an archive (.tgz or .tar.gz))",
      "icon": "https://raw.githubusercontent.com/expo/expo-cli/master/assets/fig/path.png",
      "name": "--template",
      "priority": 76
    },
    {
      "args": [
        {
          "isOptional": true,
          "name": "boolean",
          "suggestions": [
            {
              "icon": "https://raw.githubusercontent.com/expo/expo-cli/master/assets/fig/true.png",
              "name": "true"
            },
            {
              "icon": "https://raw.githubusercontent.com/expo/expo-cli/master/assets/fig/false.png",
              "name": "false"
            }
          ]
        }
      ],
      "description": "Use npm to install dependencies (default when Yarn is not installed)",
      "icon": "fig://icon?type=npm",
      "name": "--use-npm",
      "priority": 75
    },
    {
      "args": [
        {
          "isOptional": true,
          "name": "boolean",
          "suggestions": [
            {
              "icon": "https://raw.githubusercontent.com/expo/expo-cli/master/assets/fig/true.png",
              "name": "true"
            },
            {
              "icon": "https://raw.githubusercontent.com/expo/expo-cli/master/assets/fig/false.png",
              "name": "false"
            }
          ]
        }
      ],
      "description": "Use Yarn Plug'n'Play to create the app",
      "icon": "fig://icon?type=yarn",
      "name": "--use-pnp",
      "priority": 75
    },
    {
      "args": [
        {
          "name": "alternative package"
        }
      ],
      "description": "Use a non-standard version of react-scripts (a specific npm version or npm tag, a custom fork published on npm, a relative path, or an archive (.tgz or .tar.gz))",
      "name": "--scripts-version",
      "priority": 74
    },
    {
      "description": "Print additional logs",
      "icon": "https://raw.githubusercontent.com/expo/expo-cli/master/assets/fig/string.png",
      "name": "--verbose",
      "priority": 1
    },
    {
      "description": "Output usage information",
      "icon": "https://raw.githubusercontent.com/expo/expo-cli/master/assets/fig/help.png",
      "name": [
        "-h",
        "--help"
      ],
      "priority": 1
    },
    {
      "description": "Output the version number",
      "icon": "https://raw.githubusercontent.com/expo/expo-cli/master/assets/fig/info.png",
      "name": [
        "-V",
        "--version"
      ],
      "priority": 1
    }
  ]
}
