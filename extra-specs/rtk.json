{
  "description": "Filter command output and track token savings",
  "name": "rtk",
  "options": [
    {
      "description": "Increase verbosity before the subcommand",
      "isRepeatable": true,
      "name": [
        "-v",
        "--verbose"
      ]
    },
    {
      "description": "Use compact output with ASCII icons",
      "isPersistent": true,
      "name": "--ultra-compact"
    },
    {
      "description": "Skip environment validation for child processes",
      "isPersistent": true,
      "name": "--skip-env"
    },
    {
      "description": "Show help",
      "isPersistent": true,
      "name": [
        "-h",
        "--help"
      ]
    },
    {
      "description": "Show the version",
      "name": [
        "-V",
        "--version"
      ]
    }
  ],
  "requiresSubcommand": true,
  "subcommands": [
    {
      "description": "List directory contents with token-optimized output",
      "loadSpec": "ls",
      "name": "ls"
    },
    {
      "description": "Directory tree with token-optimized output",
      "loadSpec": "tree",
      "name": "tree"
    },
    {
      "args": [
        {
          "description": "Files to read",
          "isVariadic": true,
          "name": "FILES",
          "template": "filepaths"
        }
      ],
      "description": "Read files with optional output filtering",
      "name": "read",
      "options": [
        {
          "args": {
            "name": "LEVEL",
            "suggestions": [
              "none",
              "minimal",
              "aggressive"
            ]
          },
          "description": "Select the output filter level",
          "name": [
            "-l",
            "--level"
          ]
        },
        {
          "args": {
            "name": "MAX_LINES"
          },
          "description": "Structural preview capped at N lines",
          "exclusiveOn": [
            "--head-lines",
            "--tail-lines"
          ],
          "name": [
            "-m",
            "--max-lines"
          ]
        },
        {
          "args": {
            "name": "HEAD_LINES"
          },
          "description": "Keep only the first N lines",
          "exclusiveOn": [
            "--max-lines",
            "--tail-lines"
          ],
          "name": "--head-lines"
        },
        {
          "args": {
            "name": "TAIL_LINES"
          },
          "description": "Keep only last N lines",
          "exclusiveOn": [
            "--max-lines",
            "--head-lines"
          ],
          "name": "--tail-lines"
        },
        {
          "description": "Show line numbers",
          "name": [
            "-n",
            "--line-numbers"
          ]
        }
      ]
    },
    {
      "args": [
        {
          "description": "File to analyze",
          "name": "FILE",
          "template": "filepaths"
        }
      ],
      "description": "Show a two-line file summary",
      "name": "smart",
      "options": [
        {
          "args": {
            "name": "MODEL",
            "suggestions": [
              "heuristic"
            ]
          },
          "description": "Model: heuristic",
          "name": [
            "-m",
            "--model"
          ]
        },
        {
          "description": "Force model download",
          "name": "--force-download"
        }
      ]
    },
